# NandaEdge Advisor local environment template
#
# Copy this file to `.env` for local use:
#
#   cp .env.example .env
#
# IMPORTANT:
# Do not put your Charles Schwab / thinkorswim username or password here.
# Use Schwab Developer OAuth app credentials and tokens only.
# NandaEdge Advisor is intentionally read-only and should not request account,
# trading, order placement, or broker account access scopes.

# Local server
HOST=localhost
PORT=8765

# Optional app password protection.
# Set this to the lowercase SHA-256 hash of your app unlock password.
# AUTH_TOKEN_HASH=

# Schwab Market Data / Trader API OAuth settings.
# Use these for read-only market data and options-chain access.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Schwab requires an HTTPS callback URL in the Developer Portal.
# This must match the Schwab Developer Portal callback exactly.
SCHWAB_CALLBACK_URL=https://nanda0210.github.io/edge-advisor/schwab/callback
SCHWAB_ACCESS_TOKEN=
SCHWAB_REFRESH_TOKEN=
SCHWAB_BASE_URL=https://api.schwabapi.com

# Optional secondary options provider.
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com

# Day Trade memory controls.
# Keep these low for Render/free-tier deployments.
SPECULATIVE_SCAN_LIMIT=5
CAP_CATEGORY_SCAN_LIMIT=5
SPEC_DAYTRADE_TTL=120
CANDLE_RESPONSE_LIMIT=80
DAYTRADE_CHART_LIMIT=20
DAYTRADE_HISTORY_DAYS=7

# Optional local WhatsApp stock feed path.
WHATSAPP_STOCK_FEED_FILE=
